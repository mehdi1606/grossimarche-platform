# ---------------------------------------------------------------------------
# Grossimarché API — environment variables
# Copy to `.env` if you want to override defaults locally. NEVER commit a real `.env`.
# Local dev works with zero env vars: application-local.yml + docker-compose.yml already
# agree on non-secret local credentials. These vars matter mainly for the prod profile.
# ---------------------------------------------------------------------------

# Active Spring profile: local | prod
SPRING_PROFILES_ACTIVE=local

# HTTP port (override if 8080 is taken locally)
SERVER_PORT=8080

# --- Database (Postgres) — REQUIRED in prod ---
DB_URL=jdbc:postgresql://localhost:5433/grossimarche
DB_USERNAME=grossimarche
DB_PASSWORD=grossimarche
DB_POOL_MAX_SIZE=10

# --- Redis — REQUIRED in prod ---
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_PASSWORD=
REDIS_SSL_ENABLED=false

# --- API / CORS ---
API_PUBLIC_URL=http://localhost:8080
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
# Back-office URL, used for the "se connecter" link in the staff invitation e-mail.
ADMIN_URL=http://localhost:4100
# Storefront URL, used for the order-tracking and offer links in customer e-mails.
STORE_URL=http://localhost:3000

# --- First back-office account ---
# Created on startup so a fresh database is never locked out: staff accounts can only be
# created by an existing ADMIN, and there is no public sign-up. A password is only ever set
# on an account that has none, so a restart cannot reset one that has since been changed.
# SET BOOTSTRAP_ADMIN_PASSWORD ANYWHERE THAT IS NOT A LOCAL MACHINE, and change it from the
# account's own password screen after the first sign-in.
BOOTSTRAP_ADMIN_ENABLED=true
BOOTSTRAP_ADMIN_EMAIL=houarimehdi7@gmail.com
# BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=Mehdi Houari

# ---------------------------------------------------------------------------
# Introduced by later prompts; listed now so the full surface is visible.
# ---------------------------------------------------------------------------

# --- JWT (B3): RS256 key pair, PEM contents (not file paths) ---
# JWT_PRIVATE_KEY=
# JWT_PUBLIC_KEY=
# JWT_KEY_ID=grossimarche-key-1
# JWT_ISSUER=https://api.grossimarche.ma

# --- OTP delivery (B4) ---
# logging (default) = code to the DEBUG log | smtp = e-mail over SMTP | live = HTTP providers
OTP_PROVIDER=logging

# SMTP account, used when OTP_PROVIDER=smtp. For Gmail, create an App Password
# (https://myaccount.google.com/apppasswords) with 2-Step Verification on and paste it
# without spaces — the account password will not authenticate. MAIL_FROM must be the
# authenticated mailbox (or one of its Gmail aliases); left empty it defaults to
# MAIL_USERNAME.
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_FROM=
# MAIL_FROM_NAME=Grossimarché

# HTTP OTP providers (OTP_PROVIDER=live) — real accounts are out of scope
# SMS_PROVIDER_API_KEY=
# EMAIL_PROVIDER_API_KEY=

# --- CMI payment (B6) — real credentials out of scope; mock gateway by default ---
# CMI_MERCHANT_ID=
# CMI_STORE_KEY=
# CMI_CALLBACK_SECRET=

# --- Object storage (B5): S3-compatible; local filesystem used in dev ---
# Where uploaded product images are written, and the public base of their URLs. Under
# docker-compose these are set to the shared volume and to /files (relative, served by the
# gateway). A relative base keeps the URLs valid whatever host the site is reached on.
# STORAGE_DIRECTORY=./data/uploads
# STORAGE_PUBLIC_BASE_URL=http://localhost:8080/files
# STORAGE_BUCKET=
# STORAGE_ACCESS_KEY=
# STORAGE_SECRET_KEY=
# STORAGE_ENDPOINT=

# --- Data-at-rest encryption (B8) ---
# DATA_ENCRYPTION_KEY=
