# Local testing on this PC. NOT the server - the server keeps using .env, which this file
# never touches.
#
# Use it explicitly, it is not picked up on its own:
#
#     docker compose --env-file .env.local up -d --build
#
# Every command afterwards needs the same flag, or compose falls back to .env and rebuilds
# against the production values:
#
#     docker compose --env-file .env.local ps
#     docker compose --env-file .env.local logs -f backend
#     docker compose --env-file .env.local down
#
# Untracked, like .env: it inherits the real mail and database credentials copied below, so it
# must not reach the repository.

# ---- What differs from the server -------------------------------------------------------
# Port 80 is unavailable on this machine and 8088 is taken (Oracle TNS Listener + FlexLM), so
# the gateway is published here instead. Change this one line to move it; the three URLs below
# have to follow, because PUBLIC_ORIGIN is what the API puts in e-mail links and what CORS
# accepts as an origin.
PUBLIC_PORT=8088
PUBLIC_ORIGIN=http://localhost:8088
STORE_URL=http://localhost:8088
ADMIN_URL=http://localhost:8088/admin

# Local profile: ephemeral JWT keys regenerated at every boot (so every restart signs everyone
# out - that is expected here, and exactly what must never be used on the server).
SPRING_PROFILES_ACTIVE=local

# The back-office account created on first boot, spelled out rather than left to the defaults
# buried in application.yml.
BOOTSTRAP_ADMIN_EMAIL=houarimehdi7@gmail.com
BOOTSTRAP_ADMIN_PASSWORD=Admin@123

# ---- Carried over from .env, unchanged --------------------------------------------------
# Same mail credentials, so approval and offer e-mails really go out while testing; same
# DB_PASSWORD, so an existing local postgres volume still opens.
DB_PASSWORD=grossimarche
NEXTAUTH_SECRET=please-change-me-32-chars-minimum-secret
OTP_PROVIDER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=houarimehdi7@gmail.com
MAIL_PASSWORD=obdlzziiobasmiwp
MAIL_FROM=houarimehdi7@gmail.com
MAIL_FROM_NAME=Grossimarché

# ---- Clés JWT stables ----------------------------------------------------------------
# Sans elles, le profil local regenere une paire a chaque demarrage et tout le monde est
# deconnecte a chaque rebuild. Generees une fois, propres a cette machine, jamais commitees.
JWT_PRIVATE_KEY=-----BEGIN PRIVATE KEY----------END PRIVATE KEY-----
JWT_PUBLIC_KEY=-----BEGIN PUBLIC KEY----------END PUBLIC KEY-----
