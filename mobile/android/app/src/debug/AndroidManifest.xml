<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- Plain HTTP, debug builds only. The development backend is http://10.0.2.2:8088 from
         the emulator, or the PC's LAN address from a phone, and Android refuses unencrypted
         traffic by default since version 9 - the sign-in request would fail with nothing
         but a network error. Release builds do not inherit this: they talk HTTPS or nothing. -->
    <application android:usesCleartextTraffic="true"/>
</manifest>
