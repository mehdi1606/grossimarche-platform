<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- Plain HTTP for profile builds too. Profile mode is how speed is measured - release
         performance, with the tooling attached - and it runs against the same local backend
         as debug. A profile build is never shipped; the release manifest stays HTTPS-only. -->
    <application android:usesCleartextTraffic="true"/>
</manifest>
