# ---------------------------------------------------------------------------
# Grossimarché — docker compose environment. Copy to `.env` and fill in.
# `docker compose` reads `.env` from this folder automatically. NEVER commit `.env`.
# Everything here has a working default, so the stack also comes up with no .env at all.
# ---------------------------------------------------------------------------

# Public entry point (the only published port) and the origin the apps advertise.
PUBLIC_PORT=8088
PUBLIC_ORIGIN=http://localhost:8088

# Postgres password (compose creates the database with it on first run).
DB_PASSWORD=grossimarche

# NextAuth signing secret for the storefront — 32+ chars in any real deployment.
NEXTAUTH_SECRET=please-change-me-32-chars-minimum-secret

# --- OTP delivery -----------------------------------------------------------
# logging = codes go to the backend log (default, no account needed)
# smtp    = e-mail codes are sent over SMTP below; SMS codes stay in the log
# live    = HTTP OTP providers (separate API credentials, not configured here)
OTP_PROVIDER=smtp

# SMTP account. For Gmail: enable 2-Step Verification, then create an App Password
# (https://myaccount.google.com/apppasswords) and use it here — not the account password.
# Paste it without spaces. MAIL_FROM must be the authenticated mailbox or a Gmail alias.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-account@gmail.com
MAIL_PASSWORD=your16charapppassword
MAIL_FROM=your-account@gmail.com
MAIL_FROM_NAME=Grossimarché
