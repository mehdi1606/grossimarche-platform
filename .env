# Copy to .env and adjust. All values have safe local defaults in docker-compose.yml.

# Public port the gateway listens on (the one door).
PUBLIC_PORT=8088
PUBLIC_ORIGIN=http://localhost:8088

# Database password (used by both Postgres and the backend).
DB_PASSWORD=grossimarche

# NextAuth secret for the storefront sessions — CHANGE THIS (32+ random chars).
NEXTAUTH_SECRET=please-change-me-32-chars-minimum-secret
