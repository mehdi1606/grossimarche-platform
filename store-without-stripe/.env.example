# Grossimarché backend. In local dev point straight at the Spring Boot API.
# Behind the docker-compose nginx proxy this becomes /api/v1 (same origin).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1
NEXT_PUBLIC_API_SOCKET_URL=http://localhost:8080

NEXT_PUBLIC_STORE_DOMAIN=http://localhost:3000/

# Cloudinary is unused (product images are served by the backend's storage service).

