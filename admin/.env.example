# Grossimarché backend. Local dev points straight at the Spring Boot API; behind the
# docker-compose nginx proxy this is /api/v1 (same origin as the admin at /admin).
VITE_APP_API_BASE_URL=http://localhost:8090/api/v1
VITE_APP_STORE_DOMAIN=http://localhost:3000
VITE_APP_API_SOCKET_URL=http://localhost:8090
VITE_APP_ADMIN_DOMAIN=http://localhost:4000
